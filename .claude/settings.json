{
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": false,
    "mattpocock-skills@mattpocock": false
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {"type": "command", "command": "python -m orch_it skills shadowed", "timeout": 60}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python -m orch_it.tickets.hook",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
